# Samadhan Setu Environment Configuration

NODE_ENV=development
PORT=3000

# Database Connection (SQLite local or PostgreSQL in production)
DATABASE_URL="postgresql://samadhan:local_dev_only@localhost:5432/samadhan_setu?schema=public"

# Redis Cache & Queue Connection
REDIS_URL="redis://localhost:6379"

# Optional legacy Upstash configuration; rate limiting uses REDIS_URL.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI Integration (Optional: fallback heuristic engine active by default)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Security & Sessions (generate with: openssl rand -base64 48)
AUTH_SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
SESSION_EXPIRY_DAYS=7

# OTP delivery. Twilio Verify manages SMS codes; SMTP sends email codes.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_PHONE_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.gov.in"
OTP_LOCAL_DELIVERY=true

# Rate Limiting

# Observability
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
METRICS_BEARER_TOKEN="replace-with-a-random-secret-at-least-32-characters"
CRON_BEARER_TOKEN="replace-with-a-random-secret-at-least-32-characters"
# Configure the exact number of trusted reverse proxies for your deployment.
TRUSTED_PROXY_HOPS=0
TRUST_PROXY=false
ATTACHMENT_CDN_HOST="cdn.samadhan.uk.gov.in"
DEMO_OFFICER_PASSWORD=""
